---
import HomeLayout from "./HomeLayout.astro";

const { current } = Astro.props;
---

<HomeLayout>
  <div class="max-w-screen-md mx-auto">
  <div class="tabs tabs-border tabs-lg">
    <a class="tab" href="/graph" class:list={[current === "graph" && "tab-active"]}>Graph</a>
    <a class="tab" href="/update" class:list={[current === "update" && "tab-active"]}>Variables</a>
  </div>
  <div class="p-4">
    <slot />
  </div>
</div>
</HomeLayout>
