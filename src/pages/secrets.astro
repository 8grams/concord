---
import { Db, Workspace } from "../db";
import GraphLayout from "../layouts/GraphLayout.astro";
import { encrypt, decrypt } from "../utils/crypto";

const workspaceId = parseInt(Astro.cookies.get("workspace").value);
const workspace = await Db.getRepository(Workspace).findOneBy({
  id: workspaceId,
});

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const keys = formData.getAll("key[]");
  const values = formData.getAll("value[]");
  
  const secrets = keys.map((key, index) => ({
    key: key.toString(),
    value: encrypt(values[index].toString())
  })).filter(secret => secret.key && secret.value);

  workspace.secrets = secrets;
  await workspace.save();

  return Astro.redirect(Astro.url);
}
---

<GraphLayout current="secrets">
  <div class="p-4 flex flex-col gap-4">
    <form method="post" class="flex flex-col gap-4" id="secrets-form">
      <div class="flex flex-col gap-4" id="secrets-list">
        {
          workspace.secrets?.map((secret, index) => (
            <div class="flex gap-2 items-start">
              <div class="form-control flex-1">
                <input
                  type="text"
                  name="key[]"
                  class="input input-bordered"
                  placeholder="Key"
                  value={secret.key}
                />
              </div>
              <div class="form-control flex-1">
                <input
                  type="text"
                  name="value[]"
                  class="input input-bordered"
                  placeholder="Value"
                  value={decrypt(secret.value)}
                />
              </div>
              <button
                type="button"
                class="btn btn-error btn-square delete-secret p-0 min-h-0 h-10 w-10"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          ))
        }
      </div>
      <button
        type="button"
        class="btn btn-accent"
        id="add-secret"
      >
        Add
      </button>
      <div class="flex">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</HomeLayout>

<script>
  function createSecretField() {
    const template = `
      <div class="flex gap-2 items-start">
        <div class="form-control flex-1">
          <input
            type="text"
            name="key[]"
            class="input input-bordered"
            placeholder="Key"
          />
        </div>
        <div class="form-control flex-1">
          <input
            type="text"
            name="value[]"
            class="input input-bordered"
            placeholder="Value"
          />
        </div>
        <button
          type="button"
          class="btn btn-error btn-square delete-secret p-0 min-h-0 h-10 w-10"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    `;
    document.getElementById('secrets-list').insertAdjacentHTML('beforeend', template);
  }

  // Add event listeners when the page loads
  document.addEventListener('DOMContentLoaded', () => {
    // Add secret button
    document.getElementById('add-secret').addEventListener('click', createSecretField);

    // Delete secret buttons (using event delegation)
    document.getElementById('secrets-list').addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.delete-secret')) {
        target.closest('.flex')?.remove();
      }
    });
  });
</script>
