---
import HomeLayout from "../layouts/HomeLayout.astro";
---

<HomeLayout>
  <div class="p-4 flex flex-col gap-4">
    <h1 class="font-bold text-lg">Proposal</h1>
    <div x-init="window.createTerminal($el)"></div>
    <h1 class="font-bold text-lg">Discussion</h1>
    <form
      class="p-4 border border-base-300 bg-base-200 flex flex-col gap-4"
      method="post"
    >
      <textarea class="textarea w-full h-32"></textarea>
      <div class="flex">
        <div class="grow"></div>
        <button class="btn btn-primary">Post Comment</button>
      </div>
    </form>
    <ul class="space-y-4" x-data>
      <template x-for="i in 3">
        <li class="border border-base-300 rounded p-4 flex flex-col gap-4">
          <div class="flex items-center gap-4">
            <div class="avatar">
              <div class="w-12 rounded-full">
                <img
                  src="https://img.daisyui.com/images/stock/photo-1534528741775-53994a69daeb.webp"
                />
              </div>
            </div>
            <div class="font-bold">Susi Maryanti</div>
          </div>
          <div>Hello world!</div>
        </li>
      </template>
    </ul>
  </div>
</HomeLayout>
