---
import GraphLayout from "../layouts/GraphLayout.astro";

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  switch (data.get("action")) {
    case "Save":
      break;
    case "Propose":
      break;
  }
}

const rows = [
  {
    key: "bastion_instance_type",
    description: "The name of the key pair to use for the VM instance",
    type: "text",
    value: "ecs.g6.large",
  },
  {
    key: "bastion_instance_type",
    description: "The name of the key pair to use for the VM instance",
    type: "text",
    value: "ecs.g6.large",
  },
  {
    key: "bastion_instance_type",
    description: "The name of the key pair to use for the VM instance",
    type: "text",
    value: "ecs.g6.large",
  },
];
---

<GraphLayout current="update">
  <h1 class="font-bold text-lg">Variables</h1>
  <form class="flex flex-col gap-4 py-4" method="post">
    {
      rows.map((row) => (
        <div class="flex">
          <div class="grow flex flex-col">
            <div>{row.key}</div>
            <div class="text-sm">{row.description}</div>
          </div>
          {row.type === "text" && (
            <input class="input" type="text" name={row.key} value={row.value} />
          )}
        </div>
      ))
    }
    <div class="flex gap-2 mt-4">
      <button class="btn btn-primary" name="action" value="Save">Save</button>
      <button class="btn btn-secondary" name="action" value="Propose">
        Propose
      </button>
    </div>
  </form>
</GraphLayout>
