---
import GraphLayout from "../layouts/GraphLayout.astro";
---

<GraphLayout current="update">
  <h1 class="font-bold text-lg">Variables</h1>
  <form class="flex flex-col gap-4 py-4" method="post">
    <div class="flex">
      <div class="grow flex flex-col">
        <div>bastion_instance_type</div>
        <div class="text-sm">The name of the key pair to use for the VM instance</div>
      </div>
      <input class="input" type="text" value="ecs.g6.large" />
    </div>
    <div class="flex">
      <div class="grow flex flex-col">
        <div>bastion_instance_type</div>
        <div class="text-sm">The name of the key pair to use for the VM instance</div>
      </div>
      <input class="input" type="text" value="ecs.g6.large" />
    </div>
    <div class="flex">
      <div class="grow flex flex-col">
        <div>bastion_instance_type</div>
        <div class="text-sm">The name of the key pair to use for the VM instance</div>
      </div>
      <input class="input" type="text" value="ecs.g6.large" />
    </div>
    <div class="flex gap-2 mt-4">
      <button class="btn btn-primary">Save</button>
      <button type="button" class="btn btn-secondary">Propose</button>
    </div>
  </form>
</GraphLayout>
