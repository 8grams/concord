---
import { Db, Workspace } from "../db";
import GraphLayout from "../layouts/GraphLayout.astro";
import fs, { unlinkSync } from "fs";
import path from "path";
import hcl from "hcl2-parser";
import { parser } from "./_type-parser";
import { execSync } from "child_process";
import { tmpdir } from "os";
import { join } from "path";
import { writeFileSync, chmodSync } from "fs";
import { decrypt } from "../utils/crypto";

const workspaceId = parseInt(Astro.cookies.get("workspace")?.value);

if (!workspaceId) {
  return Astro.redirect("/workspaces");
}

const workspace = await Db.getRepository(Workspace).findOneBy({
  id: workspaceId,
});

const gitRepo = `data/repositories/${workspaceId}`;

const tfVarsFile = path.resolve(
  `${gitRepo}/${workspace.mainDirectory}/terraform.tfvars`
);

let config: string | null = null;

const tempKeyPath = join(tmpdir(), `tempkey-${Date.now()}`);
writeFileSync(tempKeyPath, decrypt(workspace?.privateKey));
chmodSync(tempKeyPath, 0o600);

// sync git
execSync(`
  cd data/repositories/${workspaceId} && \
  GIT_SSH_COMMAND="ssh -i ${tempKeyPath} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no" git pull origin ${workspace.mainBranch}
`);

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  switch (data.get("action")) {
    case "Save":
      config = "";
      for (let [key, value] of data.entries()) {
        if (key === "action") {
          continue;
        }
        value = JSON.parse(value as string);
        config += `${key} = `;
        if (Array.isArray(value)) {
          config += `[\n`;
          let next = false;
          for (let element of value) {
            if (next) {
              config += `,\n`;
            } else {
              next = true;
            }
            if (typeof element === "object") {
              config += `  {\n`;
              for (let key in element) {
                config += `    ${key} = ${JSON.stringify(element[key])}\n`;
              }
              config += `  }`;
            } else {
              config += `  ${JSON.stringify(element)}`;
            }
          }
          config += `\n]`;
        } else if (typeof value === "object") {
          config += `{\n`;
          for (let key in value) {
            config += `  ${key} = ${JSON.stringify(value[key])}\n`;
          }
          config += `}`;
        } else {
          config += JSON.stringify(value);
        }
        config += `\n`;
      }
      
      // sync git
      execSync(`
        cd data/repositories/${workspaceId} && \
        GIT_SSH_COMMAND="ssh -i ${tempKeyPath} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no" git pull origin ${workspace?.mainBranch}
      `);
      fs.writeFileSync(tfVarsFile, config);

      // update git
      execSync(`
        cd data/repositories/${workspaceId} &&
        git add . && \
        git commit -m "Update terraform.tfvars" && \
        git push origin ${workspace?.mainBranch}
      `);

      return Astro.redirect("/update");
    case "Propose":
      break;
  }
}

unlinkSync(tempKeyPath);

// get content string of tfvars file
const tfVarsDefinitionFile = path.resolve(
  `${gitRepo}/${workspace.mainDirectory}/variables.tf`
);
const tfVarContent = fs.readFileSync(tfVarsFile, "utf-8");
const tfVarDefinitionContent = fs.readFileSync(tfVarsDefinitionFile, "utf-8");

const tfVarsParsed = hcl.parseToObject(tfVarContent);
const tfVarDefinitionParsed = hcl.parseToObject(tfVarDefinitionContent);
---

<GraphLayout current="update">
  <form class="flex flex-col gap-4 py-4" method="post">
    {
      Object.entries(tfVarsParsed[0]).map(([key, value]) => {
        const def = tfVarDefinitionParsed[0].variable[key][0];
        const type = parser.parse(def.type.substring(2, def.type.length - 1));
        return (
          <div class="flex border-b pb-4 border-b-base-300">
            <div class="grow flex flex-col">
              <div>{key}</div>
              <div class="text-sm">{def.description}</div>
            </div>
            <div
              x-data="{ 
                type: JSON.parse($el.dataset.type),
                value: JSON.parse($el.dataset.value),
              }"
              data-type={JSON.stringify(type)}
              data-value={JSON.stringify(value)}
            >
              <input
                type="hidden"
                name={key}
                x-bind:value="JSON.stringify(value)"
              />
              {/* Bool */}
              <template x-if="type.tag === 'bool'">
                <input class="checkbox" type="checkbox" x-model="value" />
              </template>
              {/* Number */}
              <template x-if="type.tag === 'number'">
                <input class="input" type="number" x-model="value" />
              </template>
              {/* String */}
              <template x-if="type.tag === 'string'">
                <input class="input" type="text" x-model="value" />
              </template>
              {/* List(String) */}
              <template x-if="type.tag === 'list' && type.type.tag === 'string'">
                <div class="flex flex-col gap-2">
                  <button
                    type="button"
                    class="btn btn-ghost btn-circle self-end"
                    x-on:click="value.push('')"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                    >
                      <path
                        fill="currentColor"
                        d="M8.75 3.75a.75.75 0 0 0-1.5 0v3.5h-3.5a.75.75 0 0 0 0 1.5h3.5v3.5a.75.75 0 0 0 1.5 0v-3.5h3.5a.75.75 0 0 0 0-1.5h-3.5z"
                      />
                    </svg>
                  </button>
                  <template x-for="(item, index) in value">
                    <div class="flex gap-2 items-center bg-base-200 p-2 rounded">
                      <input class="input" type="text" x-model="value[index]" />
                      <button
                        type="button"
                        class="btn btn-ghost btn-circle self-end"
                        x-on:click="value.splice(index, 1)"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                        >
                          <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.286a1.5 1.5 0 0 0 1.492-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25m2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75zM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6m3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </button>
                    </div>
                  </template>
                </div>
              </template>
              {/* Map(String) */}
              <template x-if="type.tag === 'map' && type.type.tag === 'string'">
                <div
                  class="flex flex-col gap-2"
                  x-data="{ array: Object.entries(value) }"
                  x-effect="value = Object.fromEntries(array)"
                >
                  <button
                    type="button"
                    class="btn btn-ghost btn-circle self-end"
                    x-on:click="array.push(['', ''])"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                    >
                      <path
                        fill="currentColor"
                        d="M8.75 3.75a.75.75 0 0 0-1.5 0v3.5h-3.5a.75.75 0 0 0 0 1.5h3.5v3.5a.75.75 0 0 0 1.5 0v-3.5h3.5a.75.75 0 0 0 0-1.5h-3.5z"
                      />
                    </svg>
                  </button>
                  <template x-for="(item, index) in array">
                    <div class="flex gap-2 items-center bg-base-200 p-2 rounded">
                      <input class="input" type="text" x-model="item[0]" />
                      <input class="input" type="text" x-model="item[1]" />
                      <button
                        type="button"
                        class="btn btn-ghost btn-circle self-end"
                        x-on:click="array.splice(index, 1)"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                        >
                          <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.286a1.5 1.5 0 0 0 1.492-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25m2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75zM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6m3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </button>
                    </div>
                  </template>
                </div>
              </template>
              {/* List(Object) */}
              <template x-if="type.tag === 'list' && type.type.tag === 'object'">
                <div class="flex flex-col gap-2">
                  <button
                    type="button"
                    class="btn btn-ghost btn-circle self-end"
                    x-on:click="value.push({})"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                    >
                      <path
                        fill="currentColor"
                        d="M8.75 3.75a.75.75 0 0 0-1.5 0v3.5h-3.5a.75.75 0 0 0 0 1.5h3.5v3.5a.75.75 0 0 0 1.5 0v-3.5h3.5a.75.75 0 0 0 0-1.5h-3.5z"
                      />
                    </svg>
                  </button>
                  <template x-for="(item, index) in value">
                    <div class="flex gap-2 items-center rounded bg-base-200 p-2">
                      <div class="flex flex-col gap-2">
                        <template x-for="prop in type.type.props">
                          <div class="flex items-center gap-2">
                            <label class="label" x-text="prop.name" />
                            <input
                              class="input"
                              type="text"
                              x-model="item[prop.name]"
                            />
                          </div>
                        </template>
                      </div>
                      <button
                        type="button"
                        class="btn btn-ghost btn-circle self-end"
                        x-on:click="value.splice(index, 1)"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                        >
                          <path
                            fill="currentColor"
                            fill-rule="evenodd"
                            d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.286a1.5 1.5 0 0 0 1.492-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25m2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75zM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6m3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </button>
                    </div>
                  </template>
                </div>
              </template>
            </div>
          </div>
        );
      })
    }
    {
      (Astro.locals.user.role === "maintainer" || Astro.locals.user.role === "editor") && (
        <div class="flex gap-2 mt-4">
          <button class="btn btn-primary" name="action" value="Save">Save</button>
          <button class="btn btn-accent" name="action" value="Propose">
        Propose
          </button>
        </div>
      )
    }
  </form>
</GraphLayout>
