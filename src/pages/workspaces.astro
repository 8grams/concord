---
import WorkspacesLayout from "../layouts/WorkspacesLayout.astro";
import NewWorkspace from "./new-workspace.astro";
import NewTankaWorkspace from "./tanka/new-workspace.astro";
import DeleteWorkspace from "./delete-workspace.astro";

import { Db, Workspace } from "../db";

const workspaces = await Db.getRepository(Workspace).find();
---

<WorkspacesLayout current="workspaces">
  <div class="self-end" x-data="{ open: false }">
    <div class="relative">
      <button class="btn btn-primary" x-on:click="open = !open">
        Create
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
      <div
        x-show="open"
        x-on:click.away="open = false"
        class="absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-base-100 z-50"
        style="display: none;"
      >
        <div class="py-1">
          <button
            class="w-full text-left px-4 py-2 text-sm hover:bg-base-200"
            x-on:click="$refs.terraformDialog.showModal(); open = false"
          >
            Terraform
          </button>
          <button
            class="w-full text-left px-4 py-2 text-sm hover:bg-base-200"
            x-on:click="$refs.tankaDialog.showModal(); open = false"
          >
            Tanka
          </button>
        </div>
      </div>
    </div>
    <NewWorkspace ref="terraformDialog" />
    <NewTankaWorkspace ref="tankaDialog"/>
  </div>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>URL</th>
        <th>Type</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        workspaces.map((workspace) => (
          <tr>
            <td>{workspace.name}</td>
            <td>{workspace.url}</td>
            <td>{workspace.type}</td>
            <td>{workspace.status}</td>
            <td class="w-1 whitespace-nowrap">
              <div class="inline-block" x-data>
                <button
                  class="btn btn-circle btn-ghost"
                  x-on:click={workspace.type === 'terraform' ? "$refs.terraformDialog.showModal()" : "$refs.tankaDialog.showModal()"}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                  >
                    <path
                      fill="currentColor"
                      fill-rule="evenodd"
                      d="M11.013 2.513a1.75 1.75 0 0 1 2.475 2.474L6.226 12.25a2.8 2.8 0 0 1-.892.596l-2.047.848a.75.75 0 0 1-.98-.98l.848-2.047a2.8 2.8 0 0 1 .596-.892z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
                <NewWorkspace id={workspace.id} ref="terraformDialog" />
                <NewTankaWorkspace id={workspace.id} ref="tankaDialog" />
              </div>
              { Astro.locals.isAdmin && (
                <div class="inline-block" x-data>
                  <button
                    class="btn btn-circle btn-ghost"
                  x-on:click="$refs.dialog.showModal()"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                  >
                    <path
                      fill="currentColor"
                      fill-rule="evenodd"
                      d="M5 3.25V4H2.75a.75.75 0 0 0 0 1.5h.3l.815 8.15A1.5 1.5 0 0 0 5.357 15h5.286a1.5 1.5 0 0 0 1.492-1.35l.815-8.15h.3a.75.75 0 0 0 0-1.5H11v-.75A2.25 2.25 0 0 0 8.75 1h-1.5A2.25 2.25 0 0 0 5 3.25m2.25-.75a.75.75 0 0 0-.75.75V4h3v-.75a.75.75 0 0 0-.75-.75zM6.05 6a.75.75 0 0 1 .787.713l.275 5.5a.75.75 0 0 1-1.498.075l-.275-5.5A.75.75 0 0 1 6.05 6m3.9 0a.75.75 0 0 1 .712.787l-.275 5.5a.75.75 0 0 1-1.498-.075l.275-5.5a.75.75 0 0 1 .786-.711"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
                  <DeleteWorkspace id={workspace.id} />
                </div>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</WorkspacesLayout>
