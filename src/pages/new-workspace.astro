---
import { Db, Workspace } from "../db";
import { rm } from "node:fs";
import { exec } from "node:child_process";

if (Astro.request.method === "POST") {
  const repository = Db.getRepository(Workspace);
  const data = await Astro.request.formData();
  const url = data.get("url") as string;
  let id = data.get("id");
  if (id) {
    await repository.update(
      { id: parseInt(id as string) },
      {
        name: data.get("name") as string,
        url,
        directory: data.get("directory") as string,
        privateKey: data.get("privateKey") as string,
        keyId: data.get("keyId") as string,
        keySecret: data.get("keySecret") as string,
        status: "Cloning",
      }
    );
  } else {
    id = (
      await repository.insert({
        name: data.get("name") as string,
        url,
        directory: data.get("directory") as string,
        privateKey: data.get("privateKey") as string,
        keyId: data.get("keyId") as string,
        keySecret: data.get("keySecret") as string,
        status: "Cloning",
      })
    ).raw;
  }
  rm(`data/workspace-${id}`, { recursive: true }, () => {
    exec(
      `git clone --filter=blob:none "${url}" data/workspace-${id}`,
      (err, stdout, stderr) => {
        repository.update(
          { id: parseInt(id as string) },
          {
            status: err ? "Error" : "Cloned",
            log: stdout + stderr,
          }
        );
      }
    );
  });
  return Astro.redirect("/workspaces");
}

const { id } = Astro.props;

const workspace: Workspace | null = id
  ? await Db.getRepository(Workspace).findOneBy({ id })
  : null;
---

<dialog x-ref="dialog" class="modal">
  <div class="modal-box">
    <form class="flex flex-col gap-4" action="/new-workspace" method="post">
      <input type="hidden" name="id" value={workspace?.id} />
      <h1 class="text-lg font-bold">Create New</h1>
      <label class="floating-label">
        <span>Name</span>
        <input
          type="text"
          placeholder="Name"
          class="input input-md w-full"
          name="name"
          value={workspace?.name}
        />
      </label>
      <label class="floating-label">
        <span>IaC URL</span>
        <input
          type="text"
          placeholder="IaC URL"
          class="input input-md w-full"
          name="url"
          value={workspace?.url}
        />
      </label>
      <label class="floating-label">
        <span>Main Directory</span>
        <input
          type="text"
          placeholder="Main Directory"
          class="input input-md w-full"
          name="directory"
          value={workspace?.directory}
        />
      </label>
      <label class="floating-label">
        <span>Private Key</span>
        <textarea
          placeholder="Private Key"
          class="textarea textarea-md w-full"
          name="privateKey"
          set:text={workspace?.privateKey}
        />
      </label>
      <label class="floating-label">
        <span>Key ID</span>
        <textarea
          placeholder="Key ID"
          class="textarea textarea-md w-full"
          name="keyId"
          set:text={workspace?.keyId}
        />
      </label>
      <label class="floating-label">
        <span>Key Secret</span>
        <textarea
          placeholder="Key Secret"
          class="textarea textarea-md w-full"
          name="keySecret"
          set:text={workspace?.keySecret}
        />
      </label>
      <label class="floating-label">
        <span>Log</span>
        <textarea
          placeholder="Log"
          class="textarea textarea-md w-full"
          set:text={workspace?.log}
          readonly
        />
      </label>
      <div class="mt-4 flex gap-2">
        <button class="btn btn-primary">Save</button>
        <button
          class="btn btn-secondary"
          type="button"
          x-on:click="$refs.dialog.close()"
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</dialog>
