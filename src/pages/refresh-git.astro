---
import { execSync } from "node:child_process";
import { Db, Workspace } from "../db";
import { tmpdir } from "os";
import { join } from "path";
import { writeFileSync, chmodSync, unlinkSync } from "fs";
import { decrypt } from "../utils/crypto";

const workspaceId = parseInt(Astro.cookies.get("workspace")?.value)

if (!workspaceId) {
  return Astro.redirect("/workspaces");
}

const workspace = await Db.getRepository(Workspace).findOneBy({
  id: workspaceId,
});

const referer = Astro.request.headers.get("referer");
const refererUrl = new URL(referer);

const tempKeyPath = join(tmpdir(), `tempkey-${Date.now()}`);
writeFileSync(tempKeyPath, decrypt(workspace?.privateKey));
chmodSync(tempKeyPath, 0o600);

let branch = Astro.cookies.get("planBranch")?.value ?? workspace.currentBranch;
if (refererUrl.pathname === "/proposal") {
  branch = Astro.cookies.get("planBranch")?.value ?? workspace.currentBranch; 
} else {
  branch = workspace.currentBranch;
}
execSync(`cd data/repositories/${workspaceId} && git config --global pull.rebase false && GIT_SSH_COMMAND="ssh -i ${tempKeyPath} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no" git pull origin ${branch}`);

unlinkSync(tempKeyPath);
// redirect back to previous page
if (referer) {
  return Astro.redirect(referer);
}

return Astro.redirect(`/`);
---
