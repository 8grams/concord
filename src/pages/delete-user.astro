---
import { Db, User } from "../db";

if (Astro.request.method === "POST") {
  const repository = Db.getRepository(User);
  const data = await Astro.request.formData();
  const id = data.get("id");
  await repository.delete({ id: parseInt(id as string) });
  return Astro.redirect("/users");
}

const { id } = Astro.props;
---

<dialog id={`delete-dialog-${id}`} class="modal">
  <div class="modal-box w-sm">
    <form class="flex flex-col gap-4" action="/delete-user" method="post">
      <input type="hidden" name="id" value={id} />
      <h1 class="text-lg font-bold">Delete User</h1>
      <div>Are you sure?</div>
      <div class="mt-4 flex gap-2">
        <button class="btn btn-primary">Yes</button>
        <button
          class="btn btn-secondary"
          type="button"
          x-on:click="$el.closest('dialog').close()"
        >
          No
        </button>
      </div>
    </form>
  </div>
</dialog>
