---
import { Db, Proposal, Workspace } from "../db";
import { tmpdir } from "os";
import { exec } from "node:child_process";
import { join } from "path";
import { writeFileSync, chmodSync, unlinkSync } from "fs";
import { decrypt } from "../utils/crypto";

const data = await Astro.request.formData();
const hash = data.get("hash") as string;

const workspaceId = parseInt(Astro.cookies.get("workspace").value);
const workspace = await Db.getRepository(Workspace).findOne({
  where: { id: workspaceId },
});

const currentBranch = workspace?.currentBranch ?? workspace?.mainBranch as string;

const tempKeyPath = join(tmpdir(), `tempkey-${Date.now()}`);
writeFileSync(tempKeyPath, decrypt(workspace?.privateKey));
chmodSync(tempKeyPath, 0o600);

const repository = Db.getRepository(Proposal);
const branch = `concord-proposal-${hash.slice(0, 6)}`;

await new Promise((resolve, reject) => {
  exec(`
  GIT_SSH_COMMAND="ssh -i ${tempKeyPath} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no" bash -c '
    git checkout ${hash}
  
    if git show-ref --verify --quiet refs/heads/${branch}; then
      echo "Local branch ${branch} already exists, checking it out..."
      git checkout ${branch}
    else
      echo "Creating new local branch ${branch}..."
      git checkout -b ${branch}
    fi
  
    if git ls-remote --exit-code --heads origin ${branch}; then
      echo "Remote branch ${branch} already exists, skipping push."
    else
      echo "Pushing new branch ${branch} to origin..."
      git push origin ${branch}
    fi
  '`,
    { cwd: `data/repositories/${workspaceId}` },
    (err, stdout, stderr) => {
      if (err) {
        unlinkSync(tempKeyPath);
        reject(err);
        return;
      }

      repository
        .insert({
          workspace: workspaceId,
          hash,
          status: "On Review",
          branch: branch,
          sourceBranch: currentBranch,
          createdBy: Astro.locals.user.id as any,
        })
        .then(() => {
          unlinkSync(tempKeyPath);
          resolve(stdout);
        })
        .catch(reject);
        
    }
  );
});

return Astro.redirect(`/proposal?hash=${hash}`);
