---
import { Db, Proposal } from "../db";

const data = await Astro.request.formData();

const hash = data.get("hash") as string;

await Db.getRepository(Proposal).insert({
  workspace: parseInt(Astro.cookies.get("workspace").value),
  hash,
  status: "On Review",
});

return Astro.redirect(`/proposal?hash=${hash}`);
---
