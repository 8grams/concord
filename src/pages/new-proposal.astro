---
import { Db, Proposal, Workspace } from "../db";
import { tmpdir } from "os";
import { exec } from "node:child_process";
import { join } from "path";
import { writeFileSync, chmodSync, unlinkSync } from "fs";
import { decrypt } from "../utils/crypto";

const data = await Astro.request.formData();
const hash = data.get("hash") as string;

const workspaceId = parseInt(Astro.cookies.get("workspace").value)
const workspace = await Db.getRepository(Workspace).findOne({ where: { id: workspaceId } });

const tempKeyPath = join(tmpdir(), `tempkey-${Date.now()}`);
writeFileSync(tempKeyPath, decrypt(workspace?.privateKey));
chmodSync(tempKeyPath, 0o600);
const repository = Db.getRepository(Proposal);
const branch = `proposal-${hash.slice(0, 6)}`;

const execPromise = new Promise((resolve, reject) => {
  exec(
    `cd data/repositories/${workspaceId} && \
     git checkout ${hash} && \
     git checkout -b ${branch} && \
     GIT_SSH_COMMAND="ssh -i ${tempKeyPath} \
      -o IdentitiesOnly=yes \
      -o StrictHostKeyChecking=no" \
      git push origin ${branch}`,
    (err, stdout, stderr) => {
      if (err) {
        unlinkSync(tempKeyPath);
        reject(err);
        return;
      }
      
      repository.insert({
        workspace: workspaceId,
        hash,
        status: "On Review",
        branch: branch,
      });

      unlinkSync(tempKeyPath);
      resolve(stdout);
    }
  );
});

await execPromise;
return Astro.redirect(`/proposal?hash=${hash}`);
