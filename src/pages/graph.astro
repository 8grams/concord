---
import GraphLayout from "../layouts/GraphLayout.astro";
import { exec as execCPS } from "child_process";
import { promisify } from "util";

let logs = [];
let graph = [];
let error = null;

try {
  if (!Astro.cookies.get("workspace")) {
    throw new Error("No workspace");
  }
  const exec = promisify(execCPS);
  const { stdout } = await exec(
    `git log --graph --max-count=20 --skip=0 --pretty=format:"@%H %h %ad|%an|%s"`,
    { cwd: `data/workspace-${Astro.cookies.get("workspace")?.value}` }
  );
  logs = stdout.split("\n").map((line) => {
    const log = line.match(
      /^(?<graph>.+?)@(?<hash>.+?)\s+(?<short>.+?)\s+(?<date>.+?)\|(?<name>.+?)\|(?<subject>.+?)$/
    )?.groups as {
      graph: string;
      hash: string;
      short: string;
      date: string;
      name: string;
      subject: string;
    };
    if (!log) {
      return line;
    }
    return log;
  });
  graph = logs.map((log) => {
    if (typeof log === "object") {
      return log.graph;
    }
    return log;
  });
} catch (err) {
  error = err;
}
---

<GraphLayout current="graph">
  {
    error && (
      <div class="alert alert-error alert-soft mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6 shrink-0 stroke-current"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
        {error.message}
      </div>
    )
  }
  <h1 class="font-bold text-lg mb-4">Commit Histories</h1>
  <div class="flex gap-4">
    <canvas id="canvas"></canvas>
    <script id="graph" type="text/json" set:html={JSON.stringify(graph)} />
    <script>
      import { gitGraph } from "./_gitgraph";
      gitGraph(
        document.getElementById("canvas"),
        JSON.parse(document.getElementById("graph").innerHTML)
      );
    </script>
    <table class="git-table">
      {
        logs.map((log) =>
          typeof log === "string" ? (
            <tr>
              <td style="line-height: 30px;">&nbsp;</td>
            </tr>
          ) : (
            <tr>
              <td>{log.short}</td>
              <td style="line-height: 30px;">
                {new Date(log.date).toLocaleDateString()}
              </td>
              <td>{log.name}</td>
              <td>{log.subject}</td>
              <td>
                <a href="/propose" class="btn btn-sm mx-4">
                  Propose
                </a>
              </td>
            </tr>
          )
        )
      }
    </table>
  </div>
</GraphLayout>
