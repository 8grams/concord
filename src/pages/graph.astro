---
import GraphLayout from "../layouts/GraphLayout.astro";
import gitlog from "gitlog";

let graph = "gitGraph";
let logs = [];
const workspaceId = Astro.cookies.get("workspace")?.value;
const repo = `data/workspace-${workspaceId}`;
try {
  logs = await gitlog({
    repo,
    all: true,
    fields: [
      "subject",
      "authorName",
      "authorDate",
      "abbrevHash",
      "hash",
      "parentHashes",
    ],
    number: 100,
  });
  graph = `
    gitGraph TB:
      ${logs.map((log) => `commit id: "${log.abbrevHash}"\n`).join("")}
  `;
} catch (error) {}

---

<GraphLayout current="graph">
  <script>
    import mermaid from "mermaid";
    mermaid.initialize({ startOnLoad: true });
  </script>
  <h1 class="font-bold text-lg">Commit Histories</h1>
  <div class="flex">
    <pre class="mermaid" set:html={graph} />
    <table class="table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Date</th>
          <th>Author</th>
          <th>Commit</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          logs.map((log) => (
            <tr>
              <td>{log.subject}</td>
              <td>{log.authorDate}</td>
              <td>{log.authorName}</td>
              <td>{log.abbrevHash}</td>
              <td>
                <a href="/propose" class="btn">
                  Propose
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</GraphLayout>
