---
import GraphLayout from "../layouts/GraphLayout.astro";
import gitlog from "gitlog";

const workspaceId = Astro.cookies.get("workspace")?.value;
const repo = `data/workspace-${workspaceId}`;
const logs = await gitlog({
  repo,
  all: true,
  fields: [
    "subject",
    "authorName",
    "authorDate",
    "abbrevHash",
    "hash",
    "parentHashes",
  ],
  number: 999,
});
console.log(logs);
---

<GraphLayout current="graph">
  <script>
    import mermaid from "mermaid";
    mermaid.initialize({ startOnLoad: true });
  </script>
  <h1 class="font-bold text-lg">Commit Histories</h1>
  <div class="flex">
    <pre class="mermaid">
      gitGraph BT:
        commit
        commit
        branch develop
        checkout develop
        commit
        commit
        checkout main
        merge develop
        commit
        commit
    </pre>
    <table class="table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Date</th>
          <th>Author</th>
          <th>Commit</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          logs.map((log) => (
            <tr>
              <td>{log.subject}</td>
              <td>{log.authorDate}</td>
              <td>{log.authorName}</td>
              <td>{log.abbrevHash}</td>
              <td>
                <a href="/propose" class="btn">
                  Propose
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</GraphLayout>
