---
import GraphLayout from "../layouts/GraphLayout.astro";
import { exec as execCPS } from "child_process";
import { promisify } from "util";
import { Db, Proposal, Workspace } from "../db";
import { getCommitURL } from "../utils/helper";
import { In } from "typeorm";

const offset = parseInt(Astro.url.searchParams.get("offset") ?? "0");

let logs: (
  | {
      graph: string;
      hash: string;
      short: string;
      date: string;
      name: string;
      subject: string;
      status?: Proposal["status"];
    }
  | string
)[] = [];
let graph: string[] = [];
let error = null;
let workspace: Workspace | null = null;

try {
  if (!Astro.cookies.get("workspace")) {
    throw new Error("No workspace selected. Go to Setting page and create a Workspace first.");
  }

  const workspaceId = Astro.cookies.get("workspace")?.value;
  workspace = await Db.getRepository(Workspace).findOneBy({ id: parseInt(workspaceId) });
  const exec = promisify(execCPS);

  // checkout to main branch
  await exec(
    `git checkout ${workspace?.mainBranch}`,
    { cwd: `data/repositories/${Astro.cookies.get("workspace")?.value}` }
  );

  const { stdout } = await exec(
    `git log --graph --max-count=20 --skip=${offset} --pretty=format:"@%H %h %ad|%an|%s"`,
    { cwd: `data/repositories/${Astro.cookies.get("workspace")?.value}` }
  );
  logs = stdout.split("\n").map((line) => {
    const log = line.match(
      /^(?<graph>.+?)@(?<hash>.+?)\s+(?<short>.+?)\s+(?<date>.+?)\|(?<name>.+?)\|(?<subject>.+?)$/
    )?.groups as {
      graph: string;
      hash: string;
      short: string;
      date: string;
      name: string;
      subject: string;
    };
    if (!log) {
      return line;
    }
    return log;
  });
  graph = logs.map((log) => {
    if (typeof log === "object") {
      return log.graph;
    }
    return log;
  });
  const proposals = await Db.getRepository(Proposal).findBy({
    workspace: parseInt(Astro.cookies.get("workspace").value),
    hash: In(
      logs.filter((log) => typeof log === "object").map((log) => log.hash)
    ),
  });
  logs = logs.map((log) => {
    if (typeof log === "object") {
      const proposal = proposals.find((proposal) => proposal.hash === log.hash);
      if (proposal) {
        log.status = proposal.status;
      }
    }
    return log;
  });
} catch (err) {
  error = "Something went wrong.";
}
---

<GraphLayout current="graph">
  {
    error && (
      <div class="alert alert-error alert-soft mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6 shrink-0 stroke-current"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        {error}
      </div>
    )
  }
  <h1 class="font-bold text-lg mb-4">Commit Histories</h1>
  <div class="flex gap-4 mb-4">
    <canvas id="canvas"></canvas>
    <script
      id="graph"
      type="text/json"
      is:inline
      set:html={JSON.stringify(graph)}
    />
    <script>
      import { gitGraph } from "./_gitgraph";
      gitGraph(
        document.getElementById("canvas"),
        JSON.parse(document.getElementById("graph").innerHTML)
      );
    </script>
    <table class="git-table">
      <tbody>
        {
          logs.map((log) =>
            typeof log === "string" ? (
              <tr>
                <td style="line-height: 30px;">&nbsp;</td>
              </tr>
            ) : (
              <tr>
                <td class="px-2" style={{ textDecoration: "underline" }}><a href={getCommitURL(workspace?.url, log.short)} target="_blank">{log.short}</a></td>
                <td class="px-2" style="line-height: 30px;">
                  {new Date(log.date).toLocaleDateString()}
                </td>
                <td class="px-2">{log.name}</td>
                <td class="px-2">{log.subject}</td>
                <td class="px-2">
                  {!log.status && (
                    <form action="/new-proposal" method="post">
                      <input type="hidden" name="hash" value={log.hash} />
                      <button class="btn btn-sm">Propose</button>
                    </form>
                  )}
                  {log.status && (
                    <a class="btn btn-sm" href={`/proposal?hash=${log.hash}`}>
                      {log.status}
                    </a>
                  )}
                </td>
              </tr>
            )
          )
        }
      </tbody>
    </table>
  </div>
  <div class="flex gap-2">
    {
      offset > 0 && (
        <a class="btn" href={`?offset=${offset - 20}`}>
          Previous
        </a>
      )
    }
    <a class="btn" href={`?offset=${offset + 20}`}>Next</a>
  </div>
</GraphLayout>
