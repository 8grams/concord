---
import { rm } from "node:fs";
import { exec } from "node:child_process";
import { tmpdir } from "os";
import { join } from "path";
import { writeFileSync, chmodSync, unlinkSync, mkdirSync } from "fs";
import { Db, Workspace } from "../../db";
import { encrypt, decrypt } from "../../utils/crypto";

if (Astro.request.method === "POST") {
  const repository = Db.getRepository(Workspace);
  const data = await Astro.request.formData();
  const url = data.get("url") as string;
  let id = data.get("id");
  const outputDirectory = data.get("outputDirectory") as string;

  const envKeys = data.getAll("envKeys[]");
  const envValues = data.getAll("envValues[]");
  const envVariables = envKeys.map((key, index) => ({
    key: key as string,
    value: encrypt(envValues[index] as string),
  }));

  const privateKey = (data.get("privateKey") as string).replace(/\r\n/g, "\n");
  const kubeconfig = (data.get("kubeconfig") as string).replace(/\r\n/g, "\n");
  
  if (id) {
    await repository.update(
      { id: parseInt(id as string) },
      {
        name: data.get("name") as string,
        mainDirectory: data.get("mainDirectory") as string,
        currentBranch: data.get("currentBranch") as string,
        mainBranch: data.get("mainBranch") as string,
        url,
        outputDirectory,
        privateKey: encrypt(privateKey),
        status: "Cloning",
        envVars: envVariables,
      },
    );
    // create output directory
    const outputDir = `data/repositories/${id}/${outputDirectory ?? "output"}`;
    mkdirSync(outputDir, { recursive: true });
    // add gitignore
    writeFileSync(`${outputDir}/.gitignore`, `*`);
  } else {
    id = (
      await repository.insert({
        name: data.get("name") as string,
        type: "tanka",
        url,
        mainDirectory: data.get("mainDirectory") as string,
        mainBranch: data.get("mainBranch") as string,
        outputDirectory,
        privateKey: encrypt(privateKey),
        kubeconfig: encrypt(kubeconfig),
        status: "Cloning",
        envVars: envVariables,
      })
    ).raw;
  }

  mkdirSync(`data/repositories`, { recursive: true });

  rm(`data/repositories/${id}`, { recursive: true }, () => {
    const tempKeyPath = join(tmpdir(), `tempkey-${Date.now()}`);
    writeFileSync(tempKeyPath, privateKey);
    chmodSync(tempKeyPath, 0o600);

    exec(
      // `git clone --filter=blob:none "${url}" data/repositories/${id}`,
      `GIT_SSH_COMMAND="ssh -i ${tempKeyPath} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no" git clone --filter=blob:none "${url}" data/repositories/${id}`,
      (err, stdout, stderr) => {
        unlinkSync(tempKeyPath);
        repository.update(
          { id: parseInt(id as string) },
          {
            status: err ? "Error" : "Cloned",
            log: stdout + stderr,
          },
        );
        if (!err) {
          const outputDir = join(
            `data/repositories/${id}`,
            outputDirectory ?? "output",
          );
          mkdirSync(outputDir, { recursive: true });
          // write gitignore
          writeFileSync(join(outputDir, ".gitignore"), "*");
        }
      },
    );
  });

  return Astro.redirect("/workspaces");
}

const { id } = Astro.props;

const workspace: Workspace | null = id
  ? await Db.getRepository(Workspace).findOneBy({ id })
  : null;
---

<script>
  import Alpine from "alpinejs";

  document.addEventListener("alpine:init", () => {
    Alpine.data("envManager", () => ({
      envVariables: [], // Initialize envVariables to avoid errors

      init() {
        this.envVariables = JSON.parse(this.$el.dataset.value) ?? [];
      },

      addEnvVariable() {
        this.envVariables.push({ key: "", value: "" });
      },

      removeEnvVariable(index) {
        this.envVariables.splice(index, 1);
      },
    }));
  });
</script>

<dialog x-ref="tankaDialog" class="modal">
  <div class="modal-box">
    <form class="flex flex-col gap-4" action="/tanka/new-workspace" method="post">
      <input type="hidden" name="id" value={workspace?.id} />
      <h1 class="text-lg font-bold">{workspace?.id ? "Edit" : "New"} Tanka Workspace</h1>
      <label class="floating-label">
        <span>Name</span>
        <input
          type="text"
          placeholder="Name"
          class="input input-md w-full"
          name="name"
          value={workspace?.name}
        />
      </label>
      <label class="floating-label">
        <span>Tanka URL</span>
        <input
          type="text"
          placeholder="Tanka URL (e.g git@github.com:example/my-tanka.git)"
          class="input input-md w-full"
          name="url"
          value={workspace?.url}
        />
      </label>
      <label class="floating-label">
        <span>Main Directory</span>
        <input
          type="text"
          placeholder="Main Directory"
          class="input input-md w-full"
          name="mainDirectory"
          value={workspace?.mainDirectory}
        />
      </label>
      <label class="floating-label">
        <span>Main Branch</span>
        <input
          type="text"
          placeholder="Main Branch"
          class="input input-md w-full"
          name="mainBranch"
          value={workspace?.mainBranch}
        />
      </label>
      <label class="floating-label">
        <span>SSH Git Private Key</span>
        <textarea
          placeholder="SSH Git Private Key"
          class="textarea textarea-md w-full"
          name="privateKey"
          rows={8}
          set:text={decrypt(workspace?.privateKey)}
        />
      </label>
      <label class="floating-label">
        <span>Kubeconfig</span>
        <textarea
          placeholder="Kubeconfig"
          class="textarea textarea-md w-full"
          name="kubeconfig"
          rows={8}
          set:text={decrypt(workspace?.kubeconfig)}
        />
      </label>
      <div
        x-data="envManager"
        data-value={JSON.stringify(
          workspace?.envVars?.map(({ key, value }) => ({
            key,
            value: decrypt(value),
          })) ?? null,
        )}
      >
        <label>
          <span>Environment Variables</span>
          <div class="env-variables space-y-4">
            <template x-for="(env, index) in envVariables" :key="index">
              <div class="flex gap-2 items-center">
                <input
                  type="text"
                  placeholder="Key"
                  class="input input-md w-1/2"
                  x-model="env.key"
                  name="envKeys[]"
                />
                <input
                  type="text"
                  placeholder="Value"
                  class="input input-md w-1/2"
                  x-model="env.value"
                  name="envValues[]"
                />
                <button
                  type="button"
                  class="btn btn-error btn-xs"
                  x-on:click="removeEnvVariable(index)"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 18L18 6M6 6l12 12"
                    >
                    </path>
                  </svg>
                </button>
              </div>
            </template>
            <button
              type="button"
              class="btn btn-secondary btn-sm mt-2"
              x-on:click="addEnvVariable"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4v16m8-8H4"
                >
                </path>
              </svg>
            </button>
          </div>
        </label>
      </div>
      <div class="mt-4 flex gap-2">
        <button class="btn btn-primary">Save</button>
        <button
          class="btn btn-secondary"
          type="button"
          x-on:click="$refs.tankaDialog.close()"
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</dialog>
