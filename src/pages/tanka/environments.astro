---
import { Db, Workspace } from "../../db";
import { readdirSync, statSync, readFileSync } from 'fs';
import HomeLayout from "../../layouts/HomeLayout.astro";
import GraphLayout from "../../layouts/GraphLayout.astro";

interface TankaSpec {
  spec?: {
    apiServer?: string;
    namespace?: string;
  };
}

const workspaceId = parseInt(Astro.cookies.get("workspace").value);
const workspace = await Db.getRepository(Workspace).findOne({
  where: { id: workspaceId },
});

let environments = [];
if (workspace.type === "tanka") { 
  environments = readdirSync(`data/repositories/${workspace.id}/${workspace.mainDirectory}/environments`)
    .filter(dir => statSync(`data/repositories/${workspace.id}/${workspace.mainDirectory}/environments/${dir}`).isDirectory())
    .map(env => {
      const specPath = `data/repositories/${workspace.id}/${workspace.mainDirectory}/environments/${env}/spec.json`;
      let spec: TankaSpec = {};
      try {
        spec = JSON.parse(readFileSync(specPath, 'utf-8'));
      } catch (e) {
        console.error(`Error reading spec.json for ${env}:`, e);
      }
      return {
        name: env,
        apiServer: spec.spec?.apiServer || 'Not configured',
        namespace: spec.spec?.namespace || 'Not configured'
      };
    });
}
---

<GraphLayout current="environments">
  <div class="p-4 flex flex-col gap-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        environments.map((env) => (
          <div class="card bg-base-200 shadow-xl">
            <div class="card-body">
              <h2 class="card-title">{env.name}</h2>
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                  <span class="font-medium">API Server:</span>
                  <span class="text-base-content/80">{env.apiServer}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-medium">Namespace:</span>
                  <span class="text-base-content/80">{env.namespace}</span>
                </div>
              </div>
              <div class="card-actions justify-end">
                <a href={`/tanka/edit?environment=${env.name}`} class="btn btn-primary">Edit</a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    {
      environments.length === 0 && (
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>No environments found in this workspace.</span>
        </div>
      )
    }
  </div>
</HomeLayout>
