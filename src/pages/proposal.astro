---
import { promisify } from "util";
import { Db, Proposal as ProposalTable, Comment, Workspace } from "../db";
import HomeLayout from "../layouts/HomeLayout.astro";
import { getBranchURL } from "../utils/helper";
import { exec as execCPS } from "child_process";
import { readdirSync, statSync } from 'fs';

const workspaceId = parseInt(Astro.cookies.get("workspace").value);
const workspace = await Db.getRepository(Workspace).findOne({
  where: { id: workspaceId },
});
const environments = readdirSync(`data/repositories/${workspace.id}/${workspace.mainDirectory}/environments`)
  .filter(dir => statSync(`data/repositories/${workspace.id}/${workspace.mainDirectory}/environments/${dir}`).isDirectory());
const hash = Astro.url.searchParams.get("hash");

const proposal = await Db.getRepository(ProposalTable).findOne({
  where: {
    workspace: workspace.id,
    hash,
  },
  relations: {
    lastPlanExecutor: true,
    applyExecutor: true,
    createdBy: true,
    rejector: true,
  },
});

const exec = promisify(execCPS);
await exec(
  `git checkout ${proposal.branch}`,
  { cwd: `data/repositories/${workspaceId}` }
);

Astro.cookies.set("planBranch", proposal.branch);

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  switch (body.get("action")) {
    case "Approve":
      // run terraform apply -auto-approve
      break;
    case "TankaApprove":
      // run tanka apply
      break;
    case "Reject":
      proposal.status = "Rejected";
      proposal.rejector = Astro.locals.user.id as any;
      await proposal.save();
      break;
    case "Plan":
      // run terraform plan
      break;
    case "TankaPlan":
      // run tanka plan
      break;
    case "Comment":
      await Db.getRepository(Comment).insert({
        workspace: workspace.id,
        hash,
        user: Astro.locals.user.id as any,
        message: body.get("message") as string,
      });
      break;
  }
  return Astro.redirect(Astro.url);
}

const comments = await Db.getRepository(Comment).find({
  where: {
    workspace: workspace.id,
    hash,
  },
  relations: {
    user: true,
  },
});
---

<HomeLayout>
  <div class="p-4 flex flex-col gap-4">
    <a href="/graph" class="btn self-start">Back</a>
    <h1 class="font-bold text-lg">Proposal</h1>
    <div class="flex flex-col gap-2 p-4 bg-base-200 rounded-lg">
      <div class="flex items-center gap-2">
        <span class="font-medium">Status:</span>
        <span
          class={`badge ${
            proposal.status === "On Review"
              ? "badge-primary"
              : proposal.status === "Applied"
                ? "badge-success"
                : "badge-error"
          }`}>{proposal.status}</span
        >
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">Type:</span>
        <span class="text-base-content/80">{ workspace.type === "terraform" ? "Terraform" : "Grafana Tanka" }</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">Branch:</span>
        <span
          class="text-base-content/80"
          style={{ textDecoration: "underline" }}
          ><a
            href={getBranchURL(workspace.url, proposal.branch)}
            target="_blank">{proposal.branch}</a
          ></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">Created by:</span>
        <span class="text-base-content/80">{ proposal.createdBy?.name }</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">{ proposal.status === "On Review" ? "Created at:" : proposal.status === "Applied" ? "Approved at:" : "Rejected at:" }</span>
        <span class="text-base-content/80">{ proposal.status === "On Review" ? proposal.createdAt.toLocaleString() : proposal.status === "Applied" ? proposal.updatedAt.toLocaleString() : proposal.updatedAt.toLocaleString() }</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">{ proposal.status === "On Review" && proposal.lastPlanExecutor ? "Last Planned by:" : proposal.status === "Applied" && proposal.applyExecutor ? "Approved by:" : proposal.status === "Rejected" && proposal.rejector ? "Rejected by:" : "" }</span>
        <span class="text-base-content/80">{ proposal.status === "On Review" ? proposal.lastPlanExecutor?.name : proposal.status === "Applied" ? proposal.applyExecutor?.name : proposal.rejector?.name }</span>
      </div>

    {
      workspace.type === "tanka" && (
        <div class="flex items-center gap-2">
          <span class="font-medium">Environment:</span>
          <div class="flex items-center gap-2">
            <select 
              class="select select-bordered select-md" 
              name="environment"
              id="environment-select"
              disabled
            >
              {
                environments.map(env => (
                  <option value={env}>{env}</option>
                ))
              }
            </select>
            <button 
              class="btn btn-sm btn-ghost"
              id="lock-button"
            >
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                class="h-4 w-4 text-base-content/50" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor"
                id="lock-icon"
              >
                <path 
                  stroke-linecap="round" 
                  stroke-linejoin="round" 
                  stroke-width="2" 
                  d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"
                />
              </svg>
            </button>
          </div>
        </div>
      )
    }
    </div>
    {
      proposal.status === "On Review" ? (
        <form class="flex gap-4" method="post" id="proposal-actions-form">
          {
            (Astro.locals.user.role === "maintainer" && proposal.lastPlanOutput !== null) && (
              <button class="btn btn-primary" name="action" value={ workspace.type === "terraform" ? "Approve" : "TankaApprove" }>Approve</button>
              <button class="btn btn-error" name="action" value="Reject">Reject</button>
            )
          }
          {
            Astro.locals.user.role !== "viewer" && (  
              <button class="btn btn-accent" name="action" value={ workspace.type === "terraform" ? "Plan" : "TankaPlan" }>
                Run Plan
              </button>
            )
          }
        </form>
      ) : proposal.status === "Applied" ? (
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>Changes have been applied. Would you like to create a Pull Request?</span>
          <div>
            <a href={getBranchURL(workspace.url, proposal.branch)} target="_blank" class="btn btn-sm btn-primary">Create PR</a>
          </div>
        </div>
      ) : null
    }

    <div
      class="rounded overflow-hidden max-h-[600px] bg-black p-4"
      x-init="window.createTerminal($el)"
    >
    </div>
    <dialog id="confirmModal" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg">Confirm Apply</h3>
        <p class="py-4">Are you sure you want to apply these changes? This action cannot be undone.</p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn">Cancel</button>
            <button class="btn btn-primary" id={ workspace.type === "terraform" ? "confirmApply" : "confirmTankaApply" }>Apply</button>
          </form>
        </div>
      </div>
    </dialog>
    <dialog id="rejectModal" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg">Confirm Reject</h3>
        <p class="py-4">Are you sure you want to reject this proposal?</p>
        <div class="modal-action">
          <form method="dialog">
            <button class="btn">Cancel</button>
            <button class="btn btn-error" form="proposal-actions-form" name="action" value="Reject">Reject</button>
          </form>
        </div>
      </div>
    </dialog>
    <h1 class="font-bold text-lg">Discussions</h1>
    <ul class="space-y-4" x-data>
      {
        comments.length > 0 ? (
          comments.map((comment) => (
            <li class="border border-base-300 rounded p-4 flex flex-col gap-4">
              <div class="flex items-center gap-4">
                <div class="avatar">
                  <div class="w-12 rounded-full">
                    <img
                      src={`https://wsrv.nl/?url=${encodeURIComponent(comment.user.picture)}`}
                    />
                  </div>
                </div>
                <div>
                  <span class="font-bold">{comment.user.name}</span>{" "}
                  <span class="text-sm text-gray-500">
                    {comment.createdAt.toLocaleString()}
                  </span>
                </div>
              </div>
              <div set:html={comment.message} />
            </li>
          ))
        ) : (
          <div class="text-center text-gray-500 py-4">There is no comments</div>
        )
      }
    </ul>
    {
      proposal.status == "On Review" && (
        <form
          class="p-4 border border-base-300 bg-base-200 flex flex-col gap-4"
          method="post"
          id="message-form"
          action="#message-form"
        >
          <trix-editor input="message"></trix-editor>
          <input type="hidden" id="message" name="message" />
          <div class="flex">
            <div class="grow"></div>
            <button class="btn btn-primary" name="action" value="Comment">
              Post
            </button>
          </div>
        </form>
      )
    }
  </div>
</HomeLayout>

<script
  is:inline
  define:vars={{
    workspaceId,
    mainDirectory: workspace.mainDirectory,
    proposalId: proposal.id,
    lastPlanOutput: proposal.lastPlanOutput,
    userId: Astro.locals.user.id,
  }}
>
  // Load xterm.js from CDN
  const script = document.createElement("script");
  script.src = "https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js";
  script.onload = () => {
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = "https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css";
    document.head.appendChild(link);

    // Add custom styles for terminal
    const style = document.createElement("style");
    style.textContent = `
      .xterm-viewport { overflow-y: auto !important; }
      .xterm-screen { padding-left: 0 !important; }
      .xterm-rows { text-align: left !important; }
      .xterm { height: 100% !important; }
    `;
    document.head.appendChild(style);

    // Initialize terminal after xterm.js is loaded
    const terminal = new Terminal({
      rows: 30,
      cols: 120,
      fontSize: 14,
      fontFamily: "monospace",
      theme: {
        background: "#000000",
        foreground: "#ffffff",
      },
      scrollback: 1000,
      cursorBlink: true,
      cursorStyle: "block",
      windowsMode: false,
      convertEol: true,
      disableStdin: true,
      scrollOnUserInput: true,
      tabStopWidth: 8,
      lineHeight: 1.2,
      scrollSensitivity: 1,
      smoothScrollDuration: 0,
    });

    const terminalContainer = document.querySelector(
      '[x-init="window.createTerminal($el)"]',
    );
    terminal.open(terminalContainer);

    // Add scroll event listener to ensure auto-scrolling
    terminal.onData(() => {
      terminal.scrollToBottom();
    });

    // Show last plan output if it exists
    if (lastPlanOutput) {
      terminal.write("\x1b[1;32mLast Output:\x1b[0m\r\n");
      terminal.write(lastPlanOutput.replace(/\n/g, "\r\n"));
    }

    // Function to run terraform plan
    async function runTerraformPlan() {
      terminal.clear();
      terminal.write("\x1b[1;32m$ terraform plan\x1b[0m\r\n");

      const response = await fetch("/api/terraform-plan", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId,
          userId,
        }),
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write("\r\n\x1b[1;32mPlan completed.\x1b[0m\r\n");
          break;
        }
        const text = decoder.decode(value);
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, "\r\n"));
      }
    }

    async function runTankaPlan() {
      terminal.clear();
      terminal.write("\x1b[1;32m$ tanka plan\x1b[0m\r\n");

      const response = await fetch("/api/tanka-plan", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId,
          userId,
        }),
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write("\r\n\x1b[1;32mPlan completed.\x1b[0m\r\n");
          break;
        }
        const text = decoder.decode(value);
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, "\r\n"));
      }
    }

    // Function to run terraform apply
    async function runTerraformApply() {
      terminal.clear();
      terminal.write(
        "\x1b[1;32m$ terraform apply\x1b[0m\r\n",
      );

      let allOutput = "";

      const response = await fetch("/api/terraform-apply", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId,
          userId,
        }),
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write("\r\n\x1b[1;32mApply completed.\x1b[0m\r\n");
          break;
        }
        const text = decoder.decode(value);
        allOutput += text;
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, "\r\n"));
      }
    }

    async function runTankaApply() {
      terminal.clear();
      terminal.write(
        "\x1b[1;32m$ tanka apply\x1b[0m\r\n",
      );

      let allOutput = "";

      const response = await fetch("/api/tanka-apply", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId,
          userId,
        }),
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write("\r\n\x1b[1;32mApply completed.\x1b[0m\r\n");
          break;
        }
        const text = decoder.decode(value);
        allOutput += text;
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, "\r\n"));
      }
    }

    // Add event listeners to the buttons
    document
      .querySelector('button[value="Plan"]')
      .addEventListener("click", (e) => {
        e.preventDefault();
        runTerraformPlan();
      });

    document
      .querySelector('button[value="TankaPlan"]')
      .addEventListener("click", (e) => {
        e.preventDefault();
        runTankaPlan();
      });

    document
      .querySelector('button[value="Approve"]')
      .addEventListener("click", (e) => {
        e.preventDefault();
        const modal = document.getElementById('confirmModal');
        modal.showModal();
      });

    document
      .querySelector('button[value="TankaApprove"]')
      .addEventListener("click", (e) => {
        e.preventDefault();
        const modal = document.getElementById('confirmModal');
        modal.showModal();
      });

    document
      .getElementById('confirmApply')
      .addEventListener("click", () => {
        const modal = document.getElementById('confirmModal');
        modal.close();
        runTerraformApply();
      });

    document
      .getElementById('confirmTankaApply')
      .addEventListener("click", () => {
        const modal = document.getElementById('confirmModal');
        modal.close();
        runTankaApply();
      });

    document
      .querySelector('button[value="Reject"]')
      .addEventListener("click", (e) => {
        e.preventDefault();
        const modal = document.getElementById('rejectModal');
        modal.showModal();
      });

    document
      .getElementById('confirmReject')
      .addEventListener("click", () => {
        const modal = document.getElementById('rejectModal');
        modal.close();
      });
  };
  document.head.appendChild(script);
</script>
<script>
  import "./../utils/trix.client";
</script>

<script>
  document.getElementById('lock-button').addEventListener('click', function() {
    const select = document.getElementById('environment-select') as HTMLSelectElement;
    const icon = document.getElementById('lock-icon');
    select.disabled = !select.disabled;
    
    if (select.disabled) {
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>';
      icon.classList.add('text-base-content/50');
      icon.classList.remove('text-primary');
    } else {
      icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>';
      icon.classList.remove('text-base-content/50');
      icon.classList.add('text-primary');
    }
  });
</script>
