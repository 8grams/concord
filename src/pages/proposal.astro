---
import { Db, Proposal as ProposalTable, Comment, Workspace } from "../db";
import HomeLayout from "../layouts/HomeLayout.astro";
import { getBranchURL } from "../utils/helper";
import { spawn } from "node:child_process";
import { join } from "node:path";
import { mkdirSync, writeFileSync } from "node:fs";

const workspaceId = parseInt(Astro.cookies.get("workspace").value);
const workspace = await Db.getRepository(Workspace).findOneBy({ id: workspaceId });
const hash = Astro.url.searchParams.get("hash");

const proposal = await Db.getRepository(ProposalTable).findOneBy({
  workspace: workspace.id,
  hash,
});

if (Astro.request.method === "POST") {
  const body = await Astro.request.formData();
  switch (body.get("action")) {
    case "Approve":
      // run terraform apply -auto-approve
      proposal.status = "Applied";
      await proposal.save();
      break;
    case "Reject":
      proposal.status = "Rejected";
      await proposal.save();
      break;
    case "Plan":
      // run terraform plan
      break;
    case "Comment":
      await Db.getRepository(Comment).insert({
        workspace: workspace.id,
        hash,
        user: Astro.locals.user.id as any,
        message: body.get("message") as string
      });
      break;
  }
  return Astro.redirect(Astro.url);
}

const comments = await Db.getRepository(Comment).find({
  where: {
    workspace: workspace.id,
    hash,
  },
  relations: {
    user: true,
  },
});
---

<HomeLayout>
  <div class="p-4 flex flex-col gap-4">
    <a href="/graph" class="btn self-start">Back</a>
    <h1 class="font-bold text-lg">Proposal</h1>
    <div class="flex flex-col gap-2 p-4 bg-base-200 rounded-lg">
      <div class="flex items-center gap-2">
        <span class="font-medium">Status:</span>
        <span class={`badge ${
          proposal.status === 'On Review' ? 'badge-primary' : 
          proposal.status === 'Applied' ? 'badge-success' : 
          'badge-error'
        }`}>{proposal.status}</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">Branch:</span>
        <span class="text-base-content/80" style={{ textDecoration: "underline" }}><a href={getBranchURL(workspace.url, proposal.branch)} target="_blank">{proposal.branch}</a></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-medium">Created at:</span>
        <span class="text-base-content/80">{proposal.createdAt.toLocaleString()}</span>
      </div>
    </div>
    {
      proposal.status === "On Review" && (
        <form class="flex gap-4" method="post">
          <button class="btn btn-primary" name="action" value="Approve">
            Approve
          </button>
          <button class="btn btn-error" name="action" value="Reject">
            Reject
          </button>
          <button class="btn btn-accent" name="action" value="Plan">
            Run Plan
          </button>
        </form>
      )
    }

    <div class="rounded overflow-hidden max-h-[600px] bg-black p-4" x-init="window.createTerminal($el)">
    </div>
    <h1 class="font-bold text-lg">Discussions</h1>
    <form
      class="p-4 border border-base-300 bg-base-200 flex flex-col gap-4"
      method="post"
    >
      <textarea class="textarea w-full h-32" name="message"></textarea>
      <div class="flex">
        <div class="grow"></div>
        <button class="btn btn-primary" name="action" value="Comment">
          Post
        </button>
      </div>
    </form>
    <ul class="space-y-4" x-data>
      {
        comments.map((comment) => (
          <li class="border border-base-300 rounded p-4 flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <div class="avatar">
                <div class="w-12 rounded-full">
                  <img src={`https://wsrv.nl/?url=${encodeURIComponent(comment.user.picture)}`} />
                </div>
              </div>
              <div><span class="font-bold">{comment.user.name}</span> <span class="text-sm text-gray-500">{comment.createdAt.toLocaleString()}</span></div>
            </div>
            <div>{comment.message}</div>
          </li>
        ))
      }
    </ul>
  </div>
</HomeLayout>

<script define:vars={{ workspaceId, mainDirectory: workspace.mainDirectory, proposalId: proposal.id, lastPlanOutput: proposal.lastPlanOutput }}>
  // Load xterm.js from CDN
  const script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js';
  script.onload = () => {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css';
    document.head.appendChild(link);

    // Add custom styles for terminal
    const style = document.createElement('style');
    style.textContent = `
      .xterm-viewport { overflow-y: auto !important; }
      .xterm-screen { padding-left: 0 !important; }
      .xterm-rows { text-align: left !important; }
      .xterm { height: 100% !important; }
    `;
    document.head.appendChild(style);

    // Initialize terminal after xterm.js is loaded
    const terminal = new Terminal({
      rows: 30,
      cols: 120,
      fontSize: 14,
      fontFamily: 'monospace',
      theme: {
        background: '#000000',
        foreground: '#ffffff'
      },
      scrollback: 1000,
      cursorBlink: true,
      cursorStyle: 'block',
      windowsMode: false,
      convertEol: true,
      disableStdin: true,
      scrollOnUserInput: true,
      tabStopWidth: 8,
      lineHeight: 1.2
    });
    
    const terminalContainer = document.querySelector('[x-init="window.createTerminal($el)"]');
    terminal.open(terminalContainer);

    // Show last plan output if it exists
    if (lastPlanOutput) {
      terminal.write('\x1b[1;32mLast Plan Output:\x1b[0m\r\n\r\n');
      terminal.write(lastPlanOutput.replace(/\n/g, '\r\n'));
    }

    // Function to run terraform plan
    async function runTerraformPlan() {
      terminal.clear();
      terminal.write('\x1b[1;32m$ terraform init\x1b[0m\r\n\r\n');
      
      const response = await fetch('/api/terraform-plan', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId
        })
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write('\r\n\x1b[1;32mPlan completed.\x1b[0m\r\n');
          break;
        }
        const text = decoder.decode(value);
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, '\r\n'));
      }
    }

    // Function to run terraform apply
    async function runTerraformApply() {
      terminal.clear();
      terminal.write('\x1b[1;32m$ terraform apply -auto-approve\x1b[0m\r\n\r\n');
      
      let allOutput = '';
      
      const response = await fetch('/api/terraform-apply', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          workspaceId,
          mainDirectory,
          proposalId
        })
      });

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) {
          terminal.write('\r\n\x1b[1;32mApply completed.\x1b[0m\r\n');
          
          // Save output to database
          await fetch('/api/save-plan-output', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              proposalId,
              output: allOutput
            })
          });
          
          break;
        }
        const text = decoder.decode(value);
        allOutput += text;
        // Ensure proper line breaks and left alignment
        terminal.write(text.replace(/\n/g, '\r\n'));
      }
    }

    // Add event listeners to the buttons
    document.querySelector('button[value="Plan"]').addEventListener('click', (e) => {
      e.preventDefault();
      runTerraformPlan();
    });

    document.querySelector('button[value="Approve"]').addEventListener('click', (e) => {
      e.preventDefault();
      runTerraformApply();
    });
  };
  document.head.appendChild(script);
</script>
