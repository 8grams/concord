---
import { Db, User } from "../db";

if (Astro.request.method === "POST") {
  const repository = Db.getRepository(User);
  const data = await Astro.request.formData();
  const id = parseInt(data.get("id") as string);
  if (id) {
    await repository.update(
      id,
      {
        email: data.get("email") as string,
        role: data.get("role") as any,
      }
    );
  } else {
    await repository.insert({
      email: data.get("email") as string,
      role: data.get("role") as any,
    });
  }
  return Astro.redirect("/users");
}

const { id } = Astro.props;

const user: User | null = id
  ? await Db.getRepository(User).findOneBy(id)
  : null;
---

<dialog x-ref="dialog" class="modal">
  <div class="modal-box">
    <form class="flex flex-col gap-4" action="/new-user" method="post">
      <input type="hidden" name="id" value={user?.id} />
      <h1 class="text-lg font-bold">{ user ? "Edit" : "New"} Eligible User Login</h1>
      <label class="floating-label">
        <span>Email</span>
        <input
          type="email"
          placeholder="Email"
          class="input input-md w-full"
          name="email"
          value={user?.email}
          autofocus
        />
      </label>
      <label class="floating-label">
        <span>Role</span>
        <select class="select select-md w-full" name="role">
          <option value="maintainer" selected={user?.role === "maintainer"}>Maintainer</option>
          <option value="editor" selected={user?.role === "editor"}>Editor</option>
          <option value="viewer" selected={user?.role === "viewer"}>Viewer</option>
        </select>
      </label>
      <div class="mt-4 flex gap-2">
        <button class="btn btn-primary">Save</button>
        <button
          class="btn btn-secondary"
          type="button"
          x-on:click="$refs.dialog.close()"
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</dialog>
