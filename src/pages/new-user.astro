---
import { Db, User } from "../db";

if (Astro.request.method === "POST") {
  const repository = Db.getRepository(User);
  const data = await Astro.request.formData();
  const id = data.get("id");
  const email = data.get("email") as string;
  const role = data.get("role") as any;

  if (id && id !== "undefined") {
    await repository.update(
      { id: parseInt(id as string) },
      {
        email,
        role,
      }
    );
  } else {
    await repository.insert({
      email,
      role,
    });
  }
  return Astro.redirect("/users");
}

const { id } = Astro.props;

const user: User | null = id
  ? await Db.getRepository(User).findOneBy({ id: parseInt(id as string) })
  : null;
---

<dialog id={`user-dialog-${id || 'new'}`} class="modal">
  <div class="modal-box">
    <form class="flex flex-col gap-4" action="/new-user" method="post">
      <input type="hidden" name="id" value={user?.id || ''} />
      <h1 class="text-lg font-bold">{ user ? "Edit" : "New"} Eligible User Login</h1>
      <label class="floating-label">
        <span>Email</span>
        <input
          type="email"
          placeholder="Email"
          class="input input-md w-full"
          name="email"
          value={user?.email}
          autofocus
        />
      </label>
      <label class="floating-label">
        <span>Role</span>
        <select class="select select-md w-full" name="role">
          <option value="maintainer" selected={user?.role === "maintainer"}>Maintainer</option>
          <option value="editor" selected={user?.role === "editor"}>Editor</option>
          <option value="viewer" selected={user?.role === "viewer"}>Viewer</option>
        </select>
      </label>
      <div class="mt-4 flex gap-2">
        <button class="btn btn-primary">Save</button>
        <button
          class="btn btn-secondary"
          type="button"
          x-on:click="$el.closest('dialog').close()"
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</dialog>
